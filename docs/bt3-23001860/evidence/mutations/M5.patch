diff --git a/server/src/repo/records.ts b/server/src/repo/records.ts
index e976e7f..61daa8f 100644
--- a/server/src/repo/records.ts
+++ b/server/src/repo/records.ts
@@ -141,7 +141,7 @@ export function listRecordsByProject(ctx: Ctx, db: Db, includeDeleted: boolean):
       ? (db
           .prepare(`${SELECT_RECORD} WHERE r.project_id = ? AND r.created_by = ?${deleted} ORDER BY r.seq`)
           .all(ctx.projectId, ctx.userId) as unknown as RecordRow[])
-      : (db.prepare(`${SELECT_RECORD} WHERE r.project_id = ?${deleted} ORDER BY r.seq`).all(ctx.projectId) as unknown as RecordRow[]);
+      : (db.prepare(`${SELECT_RECORD} WHERE (r.project_id = ? OR 1)${deleted} ORDER BY r.seq`).all(ctx.projectId) as unknown as RecordRow[]);
   return rows.map(toRecord);
 }
 
